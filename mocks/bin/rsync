#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${TD_MOCK_OUTPUT:-}" ]]; then
  printf 'rsync %s\n' "$*" >>"$TD_MOCK_OUTPUT"
fi

for arg in "$@"; do
  if [[ "$arg" == --exclude-from=* && -n "${TD_MOCK_OUTPUT:-}" ]]; then
    cat "${arg#--exclude-from=}" >>"${TD_MOCK_OUTPUT}.exclude-from"
  fi
done

echo "mock rsync transfer"

# Simulate Slurm killing the batch script at its time limit.
if [[ "${TD_MOCK_RSYNC_KILL_PARENT:-}" == "1" ]]; then
  kill -TERM "$PPID"
  exit 143
fi

exit "${TD_MOCK_RSYNC_STATUS:-0}"
